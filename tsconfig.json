{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM","DOM.Iterable","ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node","vite/client"]
  },
  "include": ["src", "server", "vite.config.ts"],
  "exclude": ["node_modules","dist"]
}
